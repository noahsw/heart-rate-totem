#pragma once

// Copy this file to secrets.h in this folder (firmware/totem/secrets.h) and
// fill it in. secrets.h is gitignored, so your strap's MAC and your PIN never
// end up in a public repo.
//
// Find MACs with firmware/find_whoop_mac/: it prints every heart rate strap
// nearby. Uppercase, colon-separated, e.g. "AA:BB:CC:DD:EE:FF".

// Your strap: a Whoop with HR Broadcast on, or any Bluetooth heart rate strap.
#define TARGET_WHOOP_MAC "AA:BB:CC:DD:EE:FF"

// Optional: friends' straps to show on the ring (up to 4), each with the
// initial it shows. Uncomment the ones you use.
// #define CREW_MAC_1 "AA:BB:CC:DD:EE:01"
// #define CREW_INITIAL_1 'V'

// Optional: the PIN for the phone remote (docs/remote/). Any length. Without
// it the PIN is 1234 and the serial log says so at boot.
// #define PHONE_PIN "4821"
